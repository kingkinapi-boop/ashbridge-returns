{
  "unit": {
    "include": ["src/**/*.test.ts", "tools/test/**/*.test.mjs", "design/**/*.test.ts", "testworld/**/*.test.ts"],
    "exclude": ["**/*.db.test.ts", "**/*.eval.test.ts", "node_modules/**"]
  },
  "db": { "include": ["src/**/*.db.test.ts", "testworld/**/*.db.test.ts"] },
  "evals": { "include": ["evals/**/*.test.ts", "src/**/*.eval.test.ts"] },
  "dbCatchAllow": [
    {
      "file": "src/core/db/index.ts",
      "text": "catch {}",
      "reason": "The first rollback of a transaction after a failure: the finally block repeats the rollback, then discards the connection or destroys it on failure, so a failed first rollback is never trusted or lost (DB16 security review, low 3)."
    }
  ],
  "tsconfig": {
    "include": [
      "next-env.d.ts",
      "src/**/*.ts",
      "src/**/*.tsx",
      "e2e/**/*.ts",
      "*.ts",
      "design/**/*.ts",
      "testworld/**/*.ts",
      ".next/types/**/*.ts",
      ".next/dev/types/**/*.ts"
    ]
  }
}
