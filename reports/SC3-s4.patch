diff --git a/tools/test/security-rules.test.mjs b/tools/test/security-rules.test.mjs
index 236c6cb..6d19ee4 100644
--- a/tools/test/security-rules.test.mjs
+++ b/tools/test/security-rules.test.mjs
@@ -777,3 +777,60 @@ describe('KNOWN entries (A407, R80 form)', () => {
     expect(applyKnown('R62-declared', [], KNOWN)).toEqual([])
   })
 })
+
+// ---------- A511 S4: SC3's db files cannot change another db file's mock by load order ----------
+// The db project runs every file in one worker with isolate false. A product module SC3's db file loads at the top
+// level stays cached for the next file, so that file's vi.mock never applies (auth.acceptance.db's node:crypto counter
+// read 0 scrypt calls on pg16, 4 of 5 test:flake runs). So SC3's db files load at the top level only libraries, the
+// rule harness and src/core/db (which src/core/db/vitest-setup.ts loads before every db file anyway), load product
+// modules inside tests, and drop every cached module in afterAll.
+const SC3_DB_FILES = ['src/contracts/security-rules.db.test.ts']
+const TOP_LEVEL_OK = (spec) =>
+  !spec.startsWith('.') || spec === '../core/db' || spec.endsWith('/__fixtures__/security-rules/harness')
+function topLevelLoadProblems(text) {
+  const out = []
+  for (const m of text.matchAll(/^import\s+(?!type\s)[^;]*?\bfrom\s+'([^']+)'/gms)) {
+    if (!TOP_LEVEL_OK(m[1])) out.push(`top-level import of product module ${m[1]}`)
+  }
+  for (const m of text.matchAll(/^import\s+'([^']+)'/gm)) {
+    if (!TOP_LEVEL_OK(m[1])) out.push(`top-level import of product module ${m[1]}`)
+  }
+  if (!/afterAll\(\(\) => \{\s*vi\.resetModules\(\)\s*\}\)/.test(text)) out.push('no afterAll(() => { vi.resetModules() })')
+  return out
+}
+
+describe('A511 S4 SC3 db files load no product module at the top level (ARC-15)', () => {
+  test('A511 S4 rule: the round 3 form (createAuth and the test users imported at the top level, no reset) is caught', () => {
+    const planted = [
+      "import { describe, expect, test } from 'vitest'",
+      "import { listTestUsers, testCredentials } from '../modules/auth/testing'",
+      "import type { Clock } from '../core/clock'",
+      "import { cloneTestDb } from '../core/db'",
+      "import { createAuth } from '../modules/auth'",
+      '',
+    ].join('\n')
+    expect(topLevelLoadProblems(planted)).toEqual([
+      'top-level import of product module ../modules/auth/testing',
+      'top-level import of product module ../modules/auth',
+      'no afterAll(() => { vi.resetModules() })',
+    ])
+  })
+  test('A511 S4 rule: type-only imports, a dynamic import inside a test and the reset pass', () => {
+    const clean = [
+      "import { afterAll, test, vi } from 'vitest'",
+      "import type * as AuthModule from '../modules/auth'",
+      "import { cloneTestDb } from '../core/db'",
+      "const loadAuth = (): Promise<typeof AuthModule> => import('../modules/auth')",
+      'afterAll(() => {',
+      '  vi.resetModules()',
+      '})',
+      '',
+    ].join('\n')
+    expect(topLevelLoadProblems(clean)).toEqual([])
+  })
+  test.each(SC3_DB_FILES)('A511 S4 %s loads no product module at the top level and resets modules after its tests', (file) => {
+    const text = fs.readFileSync(path.join(ROOT, file), 'utf8')
+    expect(text, `${file} imports the rule harness (the scan read the file)`).toContain('/__fixtures__/security-rules/harness')
+    expect(topLevelLoadProblems(text)).toEqual([])
+  })
+})
