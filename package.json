{
  "name": "ashbridge-returns",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "dev:testworld": "node -e \"console.log('test world not loaded yet')\"",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit && vitest run --project db",
    "test:changed": "vitest run --changed --project unit && vitest run --changed --project db --passWithNoTests",
    "test:flake": "node tools/test-flake.mjs",
    "e2e": "next build && playwright test",
    "mutate:changed": "stryker run --incremental"
  },
  "dependencies": {
    "fast-check": "4.10.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
